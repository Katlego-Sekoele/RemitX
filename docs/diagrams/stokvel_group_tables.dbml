// Stokvel group, cycle and payout tables (R2-04 #226, R2-05 #227, R3-03 #240). Render (needs graphviz's `dot`):
//   npx @softwaretechnik/dbml-renderer@1.0.30 -i stokvel_group_tables.dbml -f dot \
//     | grep -v 'style=invis' \
//     | sed 's/rankdir=LR;/rankdir=LR; nodesep=0.6; ranksep=1.4;/; s/"transparent"/"white"/' \
//     | dot -Tsvg -o stokvel_group_tables.svg
// (!) in the diagram means NOT NULL.
// users, accounts, beneficiaries, quotes, remittances and transactions are stubs: only the columns these tables
// reference. Rounds and payout positions are 0-based, like the contract.

Table users {
  id uuid [pk]
}

Table accounts {
  account_id uuid [pk]
}

Table beneficiaries {
  beneficiary_id uuid [pk]
}

Table quotes {
  quote_id uuid [pk]
}

Table remittances {
  remittance_id uuid [pk]
}

Table transactions {
  tx_id uuid [pk]
}

Table stokvels {
  id uuid [pk, note: 'on-chain id (bytes32)']
  organiser_user_id uuid [not null, ref: > users.id]
  name text [not null]
  currency text [not null, note: 'Stokvel currency (fiat)']
  contribution_amount "numeric(20,8)" [not null, note: 'UCTUSD, fixed for life']
  account_id uuid [unique, ref: - accounts.account_id, note: 'its STOKVEL account']
  current_cycle_id uuid [ref: - stokvel_cycles.id, note: 'latest cycle; null until the first']
  created_at timestamptz [not null]
  deactivated_at timestamptz [note: 'null while in service']
}

Table stokvel_members {
  id uuid [pk, note: 'on-chain memberId']
  stokvel_id uuid [not null, ref: > stokvels.id]
  user_id uuid [not null, ref: > users.id]
  account_id uuid [not null, ref: > accounts.account_id, note: 'member USER account in the stokvel currency']
  invitation_id uuid [unique, ref: - stokvel_invitations.id, note: 'null for the Organiser']
  joined_at timestamptz [not null]
  left_at timestamptz [note: 'null while a member']

  Note: 'unique (stokvel_id, user_id) where left_at is null'
}

Table stokvel_invitations {
  id uuid [pk]
  stokvel_id uuid [not null, ref: > stokvels.id]
  invitee_user_id uuid [not null, ref: > users.id]
  invited_by_user_id uuid [not null, ref: > users.id]
  status text [not null, note: 'pending | accepted | declined | revoked | lapsed']
  created_at timestamptz [not null]
  status_changed_at timestamptz
  status_changed_by_user_id uuid [ref: > users.id]

  Note: 'unique (stokvel_id, invitee_user_id) where status = pending'
}

Table stokvel_cycles {
  id uuid [pk]
  stokvel_id uuid [not null, ref: > stokvels.id]
  cycle_number int [not null, note: 'from 1']
  status text [not null, note: 'forming | active | closed']
  total_rounds int [note: 'set at start, >= 2']
  current_round int [note: '0-based']
  started_at timestamptz [note: 'null while forming']
  closed_at timestamptz [note: 'set when closed']

  Note: 'unique (stokvel_id, cycle_number); unique (stokvel_id) where status <> closed'
}

Table stokvel_rounds {
  cycle_id uuid [pk, ref: > stokvel_cycles.id]
  round int [pk, note: 'contract uint8 round']
  start_time timestamptz [not null]
  deadline timestamptz [not null, note: 'informational']
  payout_time timestamptz [not null, note: 'hard gate (D12)']

  Note: 'start_time <= deadline <= payout_time'
}

Table stokvel_cycle_members {
  cycle_id uuid [pk, ref: > stokvel_cycles.id]
  member_id uuid [pk, ref: > stokvel_members.id, note: 'on-chain memberId']
  payout_position int [note: 'the round that pays them']
  payout_beneficiary_id uuid [ref: > beneficiaries.beneficiary_id]
  payout_currency text [note: 'set with the beneficiary']
  continued boolean [note: 'null until chosen']
  locked boolean [not null, note: 'set when the cycle starts']

  Note: 'unique (cycle_id, payout_position)'
}

Table stokvel_payouts {
  id uuid [pk]
  cycle_id uuid [not null]
  round int [not null, note: 'the round paid out']
  member_id uuid [not null, note: 'the member the round pays']
  release_status text [not null, note: 'pending | processing | released | failed']
  release_tx_hash text [unique, note: 'stored before the send; required once released']
  release_block_number bigint [note: 'RoundFinalised block; required once released']
  release_tx_id uuid [unique, ref: - transactions.tx_id, note: 'stokvel_pool_release ledger leg; required once released']
  remittance_status text [not null, note: 'pending | processing | confirmed | failed']
  quote_id uuid [unique, ref: - quotes.quote_id, note: 'stokvel-sender quote']
  remittance_id uuid [unique, ref: - remittances.remittance_id, note: 'reference shown to members']
  burn_tx_hash text [unique, note: 'set once burnt']
  created_at timestamptz [not null]
  released_at timestamptz [note: 'set exactly when released']
  updated_at timestamptz [not null]

  Note: 'unique (cycle_id, round); member payout_position = round (trigger)'
}

Ref: stokvel_payouts.(cycle_id, round) > stokvel_rounds.(cycle_id, round)
Ref: stokvel_payouts.(cycle_id, member_id) > stokvel_cycle_members.(cycle_id, member_id)
