# Auto-generated by Terraform (infra/modules/budget-killswitch). Do not edit
# the deployed copy directly — edit scale-to-zero.ps1.tftpl and re-apply.
#
# Fired by the resource group's budget alert once actual monthly spend hits
# the full cap. Scales every listed Container App to 0/0 replicas so nothing
# keeps billing. This is a delayed, best-effort circuit breaker, not an
# instant one — Azure evaluates "Actual" budget thresholds on a lag of up to
# ~24h, so some overspend past the cap is possible before this runs.
#
# Recovery: raise the cap, wait for next month, or manually
# `az containerapp update --min-replicas X --max-replicas Y` on each app;
# the next `terraform apply` also restores the configured replica counts.

param(
    [object]$WebhookData
)

$ErrorActionPreference = "Stop"

$subscriptionId    = "${subscription_id}"
$resourceGroupName = "${resource_group_name}"
$containerAppNames = '${container_app_names_json}' | ConvertFrom-Json

# System-assigned managed identity token via Azure Instance Metadata Service —
# no Az module import required.
$tokenResponse = Invoke-RestMethod -Method Get `
    -Uri "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2019-08-01&resource=https%3A%2F%2Fmanagement.azure.com%2F" `
    -Headers @{ Metadata = "true" }
$accessToken = $tokenResponse.access_token

$body = @{
    properties = @{
        template = @{
            scale = @{
                minReplicas = 0
                maxReplicas = 0
            }
        }
    }
} | ConvertTo-Json -Depth 5

foreach ($appName in $containerAppNames) {
    $uri = "https://management.azure.com/subscriptions/$subscriptionId/resourceGroups/$resourceGroupName/providers/Microsoft.App/containerApps/$appName`?api-version=2024-03-01"

    Write-Output "Budget cap hit — scaling $appName to 0/0 replicas..."
    try {
        Invoke-RestMethod -Method Patch -Uri $uri `
            -Headers @{ Authorization = "Bearer $accessToken" } `
            -Body $body -ContentType "application/json" | Out-Null
        Write-Output "$appName scaled to zero."
    } catch {
        Write-Error "Failed to scale $appName : $_"
    }
}
