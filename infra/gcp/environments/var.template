# Per-environment overrides: copy to qa.tfvars / prod.tfvars (committed).
# Shared product config: common.tfvars (loaded automatically by make / CI).
# Secrets: GitHub Environment secrets as TF_VAR_* (see infra/README.md).

environment = "qa" # or prod
git_branch  = "main"
repo_url    = "https://github.com/Katlego-Sekoele/RemitX"

gcp_project_id = "REPLACE_WITH_GCP_PROJECT_ID"
gcp_region     = "africa-south1"

api_custom_domain       = "api.qa.example.com"
frontend_custom_domain  = "qa.example.com"

# Same GCP project for QA + prod: on prod.tfvars only:
# github_deploy_service_account_email = "remitx-github-deploy@YOUR_PROJECT_ID.iam.gserviceaccount.com"
# And set GitHub secret TF_VAR_redis_url on prod to the QA workspace redis_url output
# (free Upstash allows one database; Celery queues are settlement-<env>).

upstash_primary_region          = "eu-west-1"
artifact_registry_repository_id = "remitx"

object_storage_endpoint_url = ""
object_storage_bucket       = "remitx-qa-kyc-documents"
object_storage_region       = "eu-central-1"

api_container_image    = "gcr.io/cloudrun/hello"
worker_container_image = "gcr.io/cloudrun/hello"
