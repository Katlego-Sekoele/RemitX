environment = "qa"
location    = "southafricanorth"
tags = {
  project     = "relyo"
  environment = "qa"
}

alert_emails       = ["team@example.com"]
monthly_budget_cap = 20
budget_start_date  = "2026-08-01T00:00:00Z"

api_min_replicas = 0

# Optional custom domains (empty for QA; set in prod tfvars)
# api_custom_domain = ""
# swa_custom_domain = ""

# Sensitive values are NOT set in committed tfvars. Pass at apply time:
#   TF_VAR_postgres_admin_password='...'
#   TF_VAR_clerk_api_key='...'          # Clerk Secret Key (Terraform provider auth)
#   TF_VAR_clerk_secret_key='...'       # same value as clerk_api_key (Key Vault runtime)
#   TF_VAR_clerk_publishable_key='...'
#   TF_VAR_clerk_jwks_url='https://<instance>.clerk.accounts.dev/.well-known/jwks.json'
#   TF_VAR_xrpl_encryption_key='...'
# Optional override (default is relyo_qa):
#   TF_VAR_database_name='relyo_qa'
