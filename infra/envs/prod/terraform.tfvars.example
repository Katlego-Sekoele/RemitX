environment = "prod"
location    = "spaincentral"
tags = {
  project     = "remitx"
  environment = "prod"
}

alert_emails       = ["team@example.com"]
monthly_budget_cap = 20
budget_start_date  = "2026-08-01T00:00:00Z"

api_min_replicas = 1

# Production custom domains — create DNS records from terraform output after apply
api_custom_domain = "api.example.com"
swa_custom_domain = "example.com"

# GHCR image path — must match github.repository (owner/repo) used in deploy workflows
ghcr_org = "org/remitx"

# Static Web Apps region (must be one of: centralus, eastus2, westus2, westeurope, eastasia)
swa_location = "eastus2"

# Sensitive values are NOT set in committed tfvars. Pass at apply time:
#   TF_VAR_database_url='postgresql+psycopg2://REDACTED:REDACTED@REDACTED.neon.tech/neondb?sslmode=require'
#   TF_VAR_clerk_secret_key='...'
#   TF_VAR_clerk_publishable_key='...'
#   TF_VAR_xrpl_encryption_key='...'
