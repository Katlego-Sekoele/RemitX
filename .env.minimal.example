# The minimum needed to run the stack locally:
#   cp .env.minimal.example .env
#
# Everything not listed here has a working default in code or in the compose
# files. .env.example documents every setting; copy a line from it into your
# .env only when you want to override that default.
#
# Name note: copy this to .env, never .env.local. Vite would load .env.local,
# but the API, the worker and Docker Compose read only .env.

# --- Docker Compose (no fallback in the compose files) ---
PORT=4200
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=remitx
POSTGRES_PASSWORD=remitx
POSTGRES_DB=remitx

# --- Local MinIO (KYC documents) ---
# MinIO falls back to these credentials when they are unset, but the API has no
# fallback, so it needs them here to be able to reach the bucket.
OBJECT_STORAGE_ACCESS_KEY_ID=remitx-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=remitx-local-secret

# --- Running the API on the host instead of in Docker ---
# Compose sets these itself for its own containers. Without DATABASE_URL a
# host-run API falls back to SQLite at api/remitx.db.
DATABASE_URL=postgresql+psycopg2://remitx:remitx@localhost:5432/remitx
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000

# --- Clerk (auth): keys from your Clerk *development* application ---
# Without these, sign-in does not work and every authenticated request fails.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Exchange rate: exchangerate-api.com key ---
# Without it, no quote can be generated, so no transfer can start.
EXCHANGE_RATE_API_KEY=

# --- XRPL EVM Treasury Wallet ---
# Leave blank: platform_wallet/scripts/create_evm_platform_wallet.py fills them.
# Without them, nothing on the blockchain completes.
EVM_ENCRYPTION_KEY=
EVM_TREASURY_ADDRESS=
EVM_TREASURY_KEY_ENCRYPTED=

# --- Stokvel contract ---
# The deployed contract and the block its event sync starts from. Shared with
# QA; the sync skips stokvels this database does not have.
STOKVEL_CONTRACT_ADDRESS=0x2f240705314BB79780522635eA47d20072CB8Fe1
STOKVEL_SYNC_START_BLOCK=8995825

# --- XRPL platform wallet (no longer used) ---
# Kept so XRPL can be restored later. Nothing reads these; leave them blank.
XRPL_ENCRYPTION_KEY=
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_SEED_ENCRYPTED=
