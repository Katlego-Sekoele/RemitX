# Configuration for the throwaway load-test stack (docker-compose.yml here) and
# the seeder's `loadtest` target. Nothing in it is secret: every service it
# names exists only on that stack's internal Docker network and is deleted when
# the run ends. It is deliberately not the repo-root .env, so a load test can
# never pick up a real Clerk key, treasury wallet or exchange-rate key.
SEEDER_TARGET=loadtest
DEBUG=false
PORT=4200

# Postgres uses trust auth inside the stack, so the URL carries no password.
DATABASE_URL=postgresql+psycopg2://loadtest@postgres:5432/loadtest
REDIS_URL=redis://redis:6379/0

# The authorized party (azp) Locust's tokens name.
CORS_ORIGINS=http://loadtest.local

OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_BUCKET=loadtest-kyc-documents
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=loadtest
OBJECT_STORAGE_SECRET_ACCESS_KEY=loadtest-secret

# External partners, all off.
# - Clerk: the API verifies tokens with CLERK_JWT_KEY, a throwaway public key
#   prepare.py generates per run. No secret key means no Clerk API calls.
# - Exchange rates: prepare.py stores rates that never expire; with no key a
#   cache miss could not reach the rate API anyway.
# - XRPL: no wallet, so the treasury-funding migration skips its balance read,
#   and the worker's burn is simulated (fake_xrpl_worker.py).
# - XRPL EVM: no treasury and no stokvel contract, so nothing can send.
CLERK_SECRET_KEY=
EXCHANGE_RATE_API_KEY=
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_SEED_ENCRYPTED=
XRPL_ENCRYPTION_KEY=
EVM_TREASURY_ADDRESS=
STOKVEL_CONTRACT_ADDRESS=
WORKER_WAKE_URL=
