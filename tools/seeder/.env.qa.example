# Copy to tools/seeder/.env.qa (gitignored) and fill in the QA values.
# Every value here is read only by the seeder, on a developer's machine.

# Must say qa. The seeder refuses to run against this file under any other
# --target, so a copy pasted into the wrong place cannot be used by accident.
SEEDER_TARGET=qa

# The QA Neon branch, owner role (the same value as the qa GitHub environment's
# MIGRATIONS_DATABASE_URL). Its host must also be listed under "qa" in
# tools/seeder/targets.json, or the seeder refuses to connect.
DATABASE_URL=

# The QA Clerk application's secret key. Must start sk_test_: the seeder refuses
# a production (sk_live_) key outright.
CLERK_SECRET_KEY=

# Neon Object Storage, QA bucket (KYC documents).
OBJECT_STORAGE_ENDPOINT_URL=https://br-divine-union-b2ysf337.storage.c-6.eu-central-1.aws.neon.tech
OBJECT_STORAGE_BUCKET=remitx-qa-kyc-documents
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Only needed for the live tail (real settlement through the QA API and XRPL).
SEEDER_API_URL=https://remitx-qa-api.onrender.com
# The browser origin the QA API accepts tokens from (its CORS_ORIGINS).
SEEDER_API_ORIGIN=https://qa.remitx.tech

# Only needed for Reset, which re-runs api/scripts/seed_platform_accounts.py.
ADMIN_CLERK_USER_ID=
PLATFORM_WALLET_ADDRESS=
XRPL_TESTNET_URL=https://s.altnet.rippletest.net:51234/
