# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Shared by docker compose, the API, and the frontend.
#
# Dev stack (Postgres + Redis + both apps, foreground logs):
#   docker compose -f docker-compose.dev.yml up --build
#
# Cloud deployment guide: docs/DEPLOYMENT.md

# --- Ports ---
PORT=4200
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Postgres (local Docker; cloud uses Neon) ---
POSTGRES_USER=remitx
POSTGRES_PASSWORD=remitx
POSTGRES_DB=remitx

# --- API (FastAPI) ---
DEBUG=true
# Local Docker Compose / host Postgres:
DATABASE_URL=postgresql+psycopg2://remitx:remitx@localhost:5432/remitx
# Neon (cloud): postgresql+psycopg2://user:pass@ep-....neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Database migrations (Alembic) ---
# Alembic owns the Postgres schema in every environment and reads DATABASE_URL
# above; nothing extra is needed locally. See api/alembic/README.md.
# In QA/production, MIGRATIONS_DATABASE_URL is a per-environment GitHub secret.

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4200
# Canonical site URL for Open Graph / social metadata (defaults to https://remitx.tech)
VITE_SITE_URL=http://localhost:5173

# --- Clerk (auth) ---
# Three Clerk applications: Development (local), QA (qa branch), Production (main).
# See docs/DEPLOYMENT.md for which keys go to which environment.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Async settlement (Celery + Redis) ---
# Local: Docker Compose worker + Redis. Cloud: Container Apps worker + internal Redis.
# See docs/DEPLOYMENT.md

# --- XRPL ---
XRPL_TESTNET_URL=https://s.altnet.rippletest.net:51234/
# Key used to encrypt XRPL wallet seeds at rest (Fernet). Generated and
# written here automatically by platform_wallet/scripts/create_xprl_platform_wallet.py
# if unset - back it up separately, losing it makes stored seeds unrecoverable.
XRPL_ENCRYPTION_KEY=
# Set by create_xprl_platform_wallet.py; the RemitX platform's own XRPL account.
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_SEED_ENCRYPTED=

# --- UCTUSD (RLUSD stand-in; see TA notice, testnet RLUSD faucet is rate-limited) ---
UCTUSD_ISSUER=rELez4x4Zqv3KYqboYVfrYPF8521Ycbxa5
UCTUSD_DISTRIBUTOR_ADDRESS=rsWPX7FKwnfk6enosumAzEuTs5Y12Steq4
UCTUSD_CURRENCY_CODE=UCTUSD
UCTUSD_CURRENCY_CODE_HEX=5543545553440000000000000000000000000000
UCTUSD_TRUST_LIMIT=1000000

# --- Celery / worker (local) ---
SKIP_REDIS_TESTS=1
