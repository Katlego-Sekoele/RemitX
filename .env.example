# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Shared by docker compose, the API, and the frontend.
#
# Dev stack (Postgres + Redis + both apps, foreground logs):
#   docker compose -f docker-compose.dev.yml up --build

# --- Ports ---
PORT=4200
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Postgres ---
POSTGRES_USER=relyo
POSTGRES_PASSWORD=relyo
POSTGRES_DB=relyo

# --- API (Flask) ---
DEBUG=true
# Used when running the API outside Docker (infra still in compose)
DATABASE_URL=postgresql+psycopg2://relyo:relyo@localhost:5432/relyo
REDIS_URL=redis://localhost:6379/0

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4200

# --- Clerk (auth — infrastructure keys; app integration deferred) ---
# Create a Clerk Development application at https://dashboard.clerk.com
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Celery / worker ---
# REDIS_URL already defined above
SKIP_REDIS_TESTS=1
