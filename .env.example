# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Shared by docker compose, the API, and the frontend.
#
# Dev stack (Postgres + Redis + both apps, foreground logs):
#   docker compose -f docker-compose.dev.yml up --build
#
# Cloud deployment guide: docs/DEPLOYMENT.md

# --- Ports ---
PORT=4200
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Postgres (local Docker; cloud uses Neon) ---
POSTGRES_USER=remitx
POSTGRES_PASSWORD=remitx
POSTGRES_DB=remitx

# --- API (FastAPI) ---
DEBUG=true
# Local Docker Compose / host Postgres:
DATABASE_URL=postgresql+psycopg2://remitx:remitx@localhost:5432/remitx
# Neon (cloud): postgresql+psycopg2://user:pass@ep-....neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Object storage (KYC documents) ---
# Neon Object Storage in the cloud, MinIO locally: both speak S3, so only the
# endpoint and credentials change. Uploads are POSTed to the API, which
# validates them and writes to the bucket itself; reads are short-lived signed
# URLs. Create the Neon bucket and keys per docs/DEPLOYMENT.md; never point
# this at a bucket that allows public reads.
OBJECT_STORAGE_BUCKET=kyc-documents
# The endpoint the API calls. Docker Compose overrides this to http://minio:9000
# for the api service; this value is for running the API on the host.
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
# The endpoint the *browser* uses. Presigned read URLs are signed for this
# host, so it must be the one the SPA can reach. Leave unset when it is the
# same as OBJECT_STORAGE_ENDPOINT_URL (it is, in the cloud).
# OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Neon ignores the region; SigV4 still requires one in the credential scope.
OBJECT_STORAGE_REGION=auto
# Local MinIO root credentials. In the cloud these are the Neon bucket keys.
OBJECT_STORAGE_ACCESS_KEY_ID=remitx-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=remitx-local-secret

# --- Database migrations (Alembic) ---
# Alembic owns the Postgres schema in every environment and reads DATABASE_URL
# above; nothing extra is needed locally. See api/alembic/README.md.
# In QA/production, MIGRATIONS_DATABASE_URL is a per-environment GitHub secret.

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4200
# How often the transfer status page polls, in milliseconds. Defaults to 3000.
VITE_TRANSFER_POLL_INTERVAL_MS=3000
# Canonical site URL for Open Graph / social metadata (defaults to https://remitx.tech)
VITE_SITE_URL=http://localhost:5173

# --- Clerk (auth) ---
# Three Clerk applications: Development (local), QA (main branch), Production (stable branch).
# See docs/DEPLOYMENT.md for which keys go to which environment.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Async settlement (Celery + Redis) ---
# Local: Docker Compose worker + Redis. Cloud: Render worker web service + Key Value.
# WORKER_WAKE_URL is unset locally. On Render the API gets the worker /health URL
# so a spun-down free worker is pinged after enqueue. See docs/DEPLOYMENT.md
# WORKER_WAKE_URL=
#
# Celery pool processes. Left to Celery this is os.cpu_count(), which sizes the
# pool to the host's cores while the memory cap is per-instance - on Render's
# free 512 MB that OOM-killed the worker before it consumed anything. Each
# process imports remitx_api and costs ~100 MB; budget accordingly.
CELERY_CONCURRENCY=2
# Worker embedded beat: re-enqueue remittance groups stuck fully pending.
SETTLEMENT_RECLAIM_INTERVAL_SECONDS=300
SETTLEMENT_RECLAIM_MIN_AGE_SECONDS=180
SETTLEMENT_PROCESSING_STALE_LOG_SECONDS=600

# --- XRPL ---
XRPL_TESTNET_URL=https://s.altnet.rippletest.net:51234/
# Key used to encrypt XRPL wallet seeds at rest (Fernet). Generated and
# written here automatically by platform_wallet/scripts/create_xprl_platform_wallet.py
# if unset - back it up separately, losing it makes stored seeds unrecoverable.
XRPL_ENCRYPTION_KEY=
# Set by create_xprl_platform_wallet.py; the RemitX platform's own XRPL account.
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_SEED_ENCRYPTED=

# --- Exchange rate (quote generation) ---
# exchangerate-api.com API key: https://v6.exchangerate-api.com/v6/<key>/pair/USD/ZAR
# Fetched lazily and cached for RATE_FIXING_INTERVAL_HOURS (see
# api/remitx_api/services/exchange_rate_service.py) — not polled on a schedule.
EXCHANGE_RATE_API_KEY=
# Hours a fetched rate may be quoted from before a fresh one is fetched.
RATE_FIXING_INTERVAL_HOURS=1
# If the live rate API fails, the most recent stored rate is reused as long
# as it isn't older than this many hours — otherwise a quote is refused
# rather than quoting a fabricated or too-stale price.
MAX_RATE_STALENESS_HOURS=26

# --- Quotes — decided fee model (Transaction_Flow_Context.md §5).
# FIXED_FEE_ZAR is denominated in ZAR and converted into the sender's own
# currency at quote time when it isn't ZAR. All-in cost on a R1,000 ZAR send: ~2.3%.
QUOTE_TTL_MINUTES=15
FIXED_FEE_ZAR=15
PERCENTAGE_FEE_RATE=0.005
FX_MARGIN_RATE=0.01
CASH_OUT_FEE_RATE=0.0075
# Floor on the cash-out fee, in the withdrawal's own currency. Every withdrawal
# writes a fee transaction and amounts must be positive, so keep this >= 0.01.
# The smallest allowed withdrawal is this plus 0.01. Provisional — see
# Transaction_Flow_Context.md Open Question #16.
MIN_CASH_OUT_FEE=0.01
# Brief's example tier table.
DAILY_LIMIT_ZAR_UNVERIFIED=0
MONTHLY_LIMIT_ZAR_UNVERIFIED=0
DAILY_LIMIT_ZAR=3000
MONTHLY_LIMIT_ZAR=25000

# --- UCTUSD (RLUSD stand-in; see TA notice, testnet RLUSD faucet is rate-limited) ---
UCTUSD_ISSUER=rELez4x4Zqv3KYqboYVfrYPF8521Ycbxa5
UCTUSD_DISTRIBUTOR_ADDRESS=rsWPX7FKwnfk6enosumAzEuTs5Y12Steq4
UCTUSD_CURRENCY_CODE=UCTUSD
UCTUSD_CURRENCY_CODE_HEX=5543545553440000000000000000000000000000
UCTUSD_TRUST_LIMIT=1000000
UCTUSD_ISSUER_LABEL=UCTUSD Issuer (Exchange)
# RemitX's own internal ledger currency code (models/orm/account.py's
# CURRENCY_TOKEN) — separate from UCTUSD_CURRENCY_CODE above.
UCTUSD_TOKEN_NAME=uctusd

# --- QA seeder (tools/seeder, local only) ---
# Its `local` target reads this file. Its `qa` target reads
# tools/seeder/.env.qa instead (copy tools/seeder/.env.qa.example).
# Optional, for the seeder's live tail against a local API:
# SEEDER_API_URL=http://localhost:4200
# SEEDER_API_ORIGIN=http://localhost:5173

# --- Celery / worker (local) ---
SKIP_REDIS_TESTS=1
